{
  "manifest_version": 3,
  "name": "Seerr Search",
  "version": "1.3.0",
  "description": "Search your Seerr instance for selected text, or request movies and shows directly.",
  "permissions": ["contextMenus", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "omnibox": { "keyword": "seerr" },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Seerr Search"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
